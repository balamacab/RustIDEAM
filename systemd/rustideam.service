[Unit]
Description=RustIDEAM GOES-16 C13 processor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/rustideam --config /etc/rustideam/config.yaml
Restart=always
RestartSec=10

# Runtime identity and hardening will be finalized during deployment.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rustideam /var/www/weewx/satellite

[Install]
WantedBy=multi-user.target
