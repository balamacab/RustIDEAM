# Static example for docker compose config. Copy to an operator-owned file
# and replace paths/URLs before running containers.
COL_TAXDATA_COMPOSE_PROJECT_NAME=col-taxdata-case-example
COL_TAXDATA_BIND_ADDRESS=127.0.0.1
COL_TAXDATA_REST_HOST_PORT=18766
COL_TAXDATA_WEB_HOST_PORT=18080
COL_TAXDATA_MCP_HOST_PORT=18000

# #301 must create/select these isolated deployment inputs before up -d.
COL_TAXDATA_CORPUS_DB_PATH=/tmp/col-taxdata-case-example/corpus.sqlite
COL_TAXDATA_CASE_STATE_PATH=/tmp/col-taxdata-case-example/state
COL_TAXDATA_LLM_PROFILE_PATH=/tmp/col-taxdata-case-example/llm-profile.json

# Must be reachable from inside the case-rest container. Do not assume
# host.docker.internal or a provider bound only to host loopback.
COL_TAXDATA_PROVIDER_BASE_URL=http://provider.example:8080/v1

# Optional. If the mounted profile sets api_key_env to
# COL_TAXDATA_LLM_API_KEY, supply the secret only in the operator-owned env.
COL_TAXDATA_LLM_API_KEY=

COL_TAXDATA_REST_V2_MAX_REQUEST_BYTES=1048576
CASE_API_READ_TIMEOUT_SECONDS=7260
CASE_REST_TIMEOUT_SECONDS=7260
MCP_PATH=/mcp
MCP_MAX_REQUEST_BYTES=1048576
MCP_MAX_RESPONSE_BYTES=8388608
MCP_BUNDLE_CACHE_ENTRIES=32

# Local-checkout builds use this tag. Immutable protected-main builds instead
# use COL_TAXDATA_REVISION from compose.case.remote.yaml for both ref and tag.
COL_TAXDATA_IMAGE_TAG=local
COL_TAXDATA_REVISION=0123456789abcdef0123456789abcdef01234567
