{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/balamacab/RustIDEAM/blob/main/col-taxdata/specs/application/schemas/case-contracts-v4.schema.json",
  "title": "col-taxdata CASE application contracts v4",
  "description": "Evidence-first CASE v4 contracts separating intake-only model output, platform-owned research/evidence/rules/evaluations, unresolved state, and a transport-safe LegalResearchBundle.",
  "oneOf": [
    {
      "$ref": "#/$defs/CaseInput"
    },
    {
      "$ref": "#/$defs/IntakeDraft"
    },
    {
      "$ref": "#/$defs/ResearchPlan"
    },
    {
      "$ref": "#/$defs/ResearchResult"
    },
    {
      "$ref": "#/$defs/CanonicalAuthority"
    },
    {
      "$ref": "#/$defs/EvidenceSpan"
    },
    {
      "$ref": "#/$defs/NormativeRelationship"
    },
    {
      "$ref": "#/$defs/RuleFragment"
    },
    {
      "$ref": "#/$defs/DeterministicEvaluation"
    },
    {
      "$ref": "#/$defs/CalculationTrace"
    },
    {
      "$ref": "#/$defs/UnresolvedItem"
    },
    {
      "$ref": "#/$defs/LegalResearchBundle"
    }
  ],
  "$defs": {
    "CaseInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "problem_text"
      ],
      "properties": {
        "kind": {
          "const": "case_input"
        },
        "contract_version": {
          "const": "4.0.0"
        },
        "problem_text": {
          "type": "string",
          "minLength": 1
        },
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "client_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "caller_metadata": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "FactMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decimal_value",
        "unit"
      ],
      "properties": {
        "decimal_value": {
          "$ref": "#/$defs/DecimalString"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "uvt_year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 9999
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "unit": {
                "const": "UVT"
              }
            },
            "required": [
              "unit"
            ]
          },
          "then": {
            "required": [
              "uvt_year"
            ]
          }
        }
      ]
    },
    "IntakeFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "fact_ref",
        "label",
        "state",
        "requires_confirmation"
      ],
      "properties": {
        "kind": {
          "const": "intake_fact"
        },
        "contract_version": {
          "const": "4.0.0"
        },
        "fact_ref": {
          "type": "string",
          "pattern": "^fact:[A-Za-z0-9._-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "semantic_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
        },
        "measurement": {
          "$ref": "#/$defs/FactMeasurement"
        },
        "state": {
          "enum": [
            "user_provided",
            "llm_normalized",
            "missing",
            "ambiguous"
          ]
        },
        "source_quote": {
          "type": "string",
          "minLength": 1
        },
        "requires_confirmation": {
          "type": "boolean"
        },
        "needed_information": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "user_provided"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "source_quote"
            ],
            "properties": {
              "requires_confirmation": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "llm_normalized"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "source_quote"
            ],
            "properties": {
              "requires_confirmation": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "missing",
                  "ambiguous"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "needed_information"
            ],
            "properties": {
              "requires_confirmation": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "CaseQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "question_ref",
        "text",
        "category",
        "status"
      ],
      "properties": {
        "kind": {
          "const": "case_question"
        },
        "contract_version": {
          "const": "4.0.0"
        },
        "question_ref": {
          "type": "string",
          "pattern": "^question:[A-Za-z0-9._-]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "legal",
            "factual",
            "procedural",
            "temporal",
            "evidentiary",
            "other"
          ]
        },
        "status": {
          "enum": [
            "open",
            "blocked"
          ]
        },
        "depends_on_fact_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^fact:[A-Za-z0-9._-]+$"
          }
        }
      }
    },
    "SearchHint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "hint_ref",
        "terms",
        "origin",
        "related_question_refs"
      ],
      "properties": {
        "kind": {
          "const": "search_hint"
        },
        "contract_version": {
          "const": "4.0.0"
        },
        "hint_ref": {
          "type": "string",
          "pattern": "^hint:[A-Za-z0-9._-]+$"
        },
        "terms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "origin": {
          "const": "internal_intake_model"
        },
        "related_question_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^question:[A-Za-z0-9._-]+$"
          }
        }
      }
    },
    "IntakeModelMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "provider",
        "model",
        "schema_version",
        "prompt_template_id",
        "prompt_template_version",
        "run_reference",
        "generated_at",
        "routing_role"
      ],
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "const": "4.0.0"
        },
        "prompt_template_id": {
          "type": "string",
          "minLength": 1
        },
        "prompt_template_version": {
          "type": "string",
          "minLength": 1
        },
        "run_reference": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "routing_role": {
          "const": "intake_structuring"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "structured_generation_mechanism": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "IntakeDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "intake_ref",
        "problem_text",
        "facts",
        "questions",
        "search_hints",
        "model_metadata"
      ],
      "properties": {
        "kind": {
          "const": "intake_draft"
        },
        "contract_version": {
          "const": "4.0.0"
        },
        "intake_ref": {
          "type": "string",
          "pattern": "^intake:[A-Za-z0-9._-]+$"
        },
        "problem_text": {
          "type": "string",
          "minLength": 1
        },
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "client_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "caller_metadata": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IntakeFact"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CaseQuestion"
          }
        },
        "search_hints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SearchHint"
          }
        },
        "model_metadata": {
          "$ref": "#/$defs/IntakeModelMetadata"
        }
      }
    },
    "ResearchBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_rounds",
        "max_queries_per_question",
        "max_hits_per_query",
        "max_reference_depth",
        "max_total_authorities"
      ],
      "properties": {
        "max_rounds": {
          "type": "integer",
          "minimum": 1
        },
        "max_queries_per_question": {
          "type": "integer",
          "minimum": 1
        },
        "max_hits_per_query": {
          "type": "integer",
          "minimum": 1
        },
        "max_reference_depth": {
          "type": "integer",
          "minimum": 0
        },
        "max_total_authorities": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ResearchTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "task_ref",
        "question_ref",
        "origin",
        "purpose",
        "query_text",
        "depth"
      ],
      "properties": {
        "kind": {
          "const": "research_task"
        },
        "contract_version": {
          "const": "4.0.0"
        },
        "task_ref": {
          "type": "string",
          "pattern": "^task:[A-Za-z0-9._-]+$"
        },
        "question_ref": {
          "type": "string",
          "pattern": "^question:[A-Za-z0-9._-]+$"
        },
        "origin": {
          "enum": [
            "platform_required",
            "intake_hint_expansion",
            "reference_expansion"
          ]
        },
        "purpose": {
          "enum": [
            "primary_research",
            "reference_expansion",
            "temporal_resolution",
            "conflict_resolution"
          ]
        },
        "query_text": {
          "type": "string",
          "minLength": 1
        },
        "generated_from_fact_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^fact:[A-Za-z0-9._-]+$"
          }
        },
        "hint_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^hint:[A-Za-z0-9._-]+$"
          }
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ResearchPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "plan_ref",
        "intake_ref",
        "tasks",
        "bounds",
        "stop_conditions",
        "planner_version",
        "generated_at"
      ],
      "properties": {
        "kind": {
          "const": "research_plan"
        },
        "contract_version": {
          "const": "4.0.0"
        },
        "plan_ref": {
          "type": "string",
          "pattern": "^plan:[A-Za-z0-9._-]+$"
        },
        "intake_ref": {
          "type": "string",
          "pattern": "^intake:[A-Za-z0-9._-]+$"
        },
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResearchTask"
          }
        },
        "bounds": {
          "$ref": "#/$defs/ResearchBounds"
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "questions_satisfied",
              "bounds_exhausted",
              "no_new_canonical_authorities",
              "blocked_by_missing_facts",
              "integrity_failure"
            ]
          }
        },
        "planner_version": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ResearchTraceStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "trace_ref",
        "task_ref",
        "round",
        "query_text",
        "outcome",
        "hit_count",
        "authority_refs",
        "unresolved_refs"
      ],
      "properties": {
        "kind": {
          "const": "research_trace_step"
        },
        "contract_version": {
          "const": "4.0.0"
        },
        "trace_ref": {
          "type": "string",
          "pattern": "^trace:[A-Za-z0-9._-]+$"
        },
        "task_ref": {
          "type": "string",
          "pattern": "^task:[A-Za-z0-9._-]+$"
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "query_text": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": [
            "hits",
            "no_hits",
            "blocked",
            "integrity_failure"
          ]
        },
        "hit_count": {
          "type": "integer",
          "minimum": 0
        },
        "authority_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^authority:[A-Za-z0-9._-]+$"
          }
        },
        "unresolved_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^unresolved:[A-Za-z0-9._-]+$"
          }
        },
        "stop_reason": {
          "enum": [
            "questions_satisfied",
            "bounds_exhausted",
            "no_new_canonical_authorities",
            "blocked_by_missing_facts",
            "integrity_failure"
          ]
        }
      }
    },
    "ResearchContextFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus_snapshot_sha256",
        "schema_migration_fingerprint",
        "retrieval_config_sha256",
        "planner_version",
        "retrieval_version",
        "as_of_date",
        "unavailable_fields"
      ],
      "properties": {
        "corpus_snapshot_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_migration_fingerprint": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieval_config_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Fa-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "planner_version": {
          "type": "string",
          "minLength": 1
        },
        "retrieval_version": {
          "type": "string",
          "minLength": 1
        },
        "as_of_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "unavailable_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "corpus_snapshot_sha256",
              "schema_migration_fingerprint",
              "retrieval_config_sha256",
              "as_of_date"
            ]
          }
        }
      }
    },
    "ResearchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "result_ref",
        "plan_ref",
        "status",
        "trace",
        "authority_refs",
        "unresolved_refs",
        "research_context",
        "generated_at"
      ],
      "properties": {
        "kind": {
          "const": "research_result"
        },
        "contract_version": {
          "const": "4.0.0"
        },
        "result_ref": {
          "type": "string",
          "pattern": "^research:[A-Za-z0-9._-]+$"
        },
        "plan_ref": {
          "type": "string",
          "pattern": "^plan:[A-Za-z0-9._-]+$"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "blocked"
          ]
        },
        "trace": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResearchTraceStep"
          }
        },
        "authority_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^authority:[A-Za-z0-9._-]+$"
          }
        },
        "unresolved_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^unresolved:[A-Za-z0-9._-]+$"
          }
        },
        "research_context": {
          "$ref": "#/$defs/ResearchContextFingerprint"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "TemporalAuthorityState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolution_state",
        "effective",
        "basis_evidence_refs"
      ],
      "properties": {
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "resolution_state": {
          "enum": [
            "resolved",
            "unresolved",
            "ambiguous",
            "not_applicable"
          ]
        },
        "effective": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "basis_evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^evidence:[A-Za-z0-9._-]+$"
          }
        }
      }
    },
    "CanonicalAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_version",
        "authority_ref",
        "document_ref",
        "provision_refs",
        "display_name",
        "legal_function",
        "classification_state",
        "temporal_state",
        "evidence_refs",
        "relationship_refs",
        "source_refs",
        "publication_metadata"
      ],
      "properties": {
        "kind": {
          "const": "canonical_authority"
        },
        "contract_version": {
          "const": "4.0.0"
        },
        "authority_ref": {
          "type": "string",
          "pattern": "^authority:[A-Za-z0-9._-]+$"
        },
        "document_ref": {
          "type": "string",
          "pattern": "^document:[A-Za-z0-9._-]+$"
        },
        "provision_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^provision:[A-Za-z0-9._-]+$"
          }
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "document_type": {
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction_scope": {
          "type": "string",
          "minLength": 1
        },
        "source_family": {
          "type": "string",
          "minLength": 1
        },
        "legal_function": {
          "enum": [
            "normative",
            "jurisprudential",
            "administrative_interpretation",
            "guidance",
            "other",
            "unknown"
          ]
        },
        "classification_state": {
          "enum": [
            "resolved",
            "partial",
            "ambiguous",
            "unknown"
          ]
        },
        "temporal_state": {
          "$ref": "#/$defs/TemporalAuthorityState"
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^evidence:[A-Za-z0-9._-]+$"
          }
        },
        "relationship_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^relationship:[A-Za-z0-9._-]+$"
          }
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^source:[A-Za-z0-9._-]+$"
          }
        },
        "publication_metadata": {
          "$ref": "#/$defs/AuthorityPublicationMetadata"
        }
