{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/balamacab/RustIDEAM/col-taxdata/automation/case-validation/schemas/control-state.schema.json",
  "title": "Col-taxdata scheduled case-validation control state",
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "case_id": {
      "type": "string",
      "pattern": "^TC-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^R-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sweep_id": {
      "type": "string",
      "pattern": "^SW-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "case_pool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "pool_id",
        "generation",
        "cases"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "case_pool"
        },
        "pool_id": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "definition_path",
              "state_path"
            ],
            "properties": {
              "case_id": {
                "$ref": "#/$defs/case_id"
              },
              "definition_path": {
                "type": "string",
                "minLength": 1
              },
              "state_path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "case_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "case_id",
        "created_at",
        "created_by",
        "title",
        "complexity",
        "domains",
        "problem_text",
        "as_of_date",
        "acceptance",
        "supersedes_case_id"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "case_definition"
        },
        "case_id": {
          "$ref": "#/$defs/case_id"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "created_by": {
          "enum": [
            "case-generator",
            "controller-monitor"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "complexity": {
          "enum": [
            "simple",
            "medium",
            "high"
          ]
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "problem_text": {
          "type": "string",
          "minLength": 1
        },
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_surfaces",
            "control_packet_ref"
          ],
          "properties": {
            "required_surfaces": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "case",
                  "rest",
                  "web",
                  "mcp"
                ]
              }
            },
            "control_packet_ref": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "supersedes_case_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/case_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "enum": [
            "generated",
            "imported_historical_validation"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "problem_text_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "control_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "case_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "case_id",
        "generation",
        "state",
        "last_run_id",
        "blocking_issues",
        "ready_reason",
        "updated_at",
        "updated_by"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "case_state"
        },
        "case_id": {
          "$ref": "#/$defs/case_id"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "enum": [
            "NEW",
            "READY",
            "RUNNING",
            "BLOCKED",
            "CLOSED",
            "RETIRED"
          ]
        },
        "last_run_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/run_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "blocking_issues": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "ready_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_by": {
          "enum": [
            "case-generator",
            "case-tester",
            "controller-monitor"
          ]
        }
      }
    },
    "sweep_discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "sweep_id",
        "discovered_at",
        "discovered_main_sha",
        "candidates"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "sweep_discovery"
        },
        "sweep_id": {
          "$ref": "#/$defs/sweep_id"
        },
        "discovered_at": {
          "$ref": "#/$defs/timestamp"
        },
        "discovered_main_sha": {
          "$ref": "#/$defs/sha1"
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "observed_state",
              "observed_generation",
              "eligibility_reason",
              "blocker_observations"
            ],
            "properties": {
              "case_id": {
                "$ref": "#/$defs/case_id"
              },
              "observed_state": {
                "enum": [
                  "NEW",
                  "READY",
                  "BLOCKED"
                ]
              },
              "observed_generation": {
                "type": "integer",
                "minimum": 0
              },
              "eligibility_reason": {
                "enum": [
                  "new",
                  "ready",
                  "blockers_converged",
                  "regression_requested",
                  "affected_change"
                ]
              },
              "blocker_observations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "issue_number",
                    "observed_state",
                    "observed_at"
                  ],
                  "properties": {
                    "issue_number": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "observed_state": {
                      "type": "string",
                      "minLength": 1
                    },
                    "convergence_sha": {
                      "oneOf": [
                        {
                          "$ref": "#/$defs/sha1"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "observed_at": {
                      "$ref": "#/$defs/timestamp"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "sweep_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "sweep_id",
        "completed_at",
        "candidate_results"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "sweep_result"
        },
        "sweep_id": {
          "$ref": "#/$defs/sweep_id"
        },
        "completed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "candidate_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "disposition",
              "run_id",
              "skip_reason"
            ],
            "properties": {
              "case_id": {
                "$ref": "#/$defs/case_id"
              },
              "disposition": {
                "enum": [
                  "executed",
                  "skipped"
                ]
              },
              "run_id": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/run_id"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "skip_reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "run_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "run_id",
        "sweep_id",
        "case_id",
        "captured_at",
        "case_definition",
        "case_state_generation",
        "repository",
        "contracts",
        "harness",
        "control_packet",
        "corpus",
        "runtime",
        "satisfied_blockers"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "run_snapshot"
        },
        "run_id": {
          "$ref": "#/$defs/run_id"
        },
        "sweep_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/sweep_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "case_id": {
          "$ref": "#/$defs/case_id"
        },
        "captured_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "case_definition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "git_blob_sha",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "git_blob_sha": {
              "oneOf": [
                {
                  "$ref": "#/$defs/sha1"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sha256": {
              "oneOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "case_state_generation": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "branch",
            "commit_sha"
          ],
          "properties": {
            "branch": {
              "const": "main"
            },
            "commit_sha": {
              "$ref": "#/$defs/sha1"
            }
          }
        },
        "contracts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "case_contract_version",
            "rest_contract_version",
            "mcp_contract_version"
          ],
          "properties": {
            "case_contract_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "rest_contract_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "mcp_contract_version": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "sha256"
          ],
          "properties": {
            "ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "sha256": {
              "oneOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "control_packet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "sha256"
          ],
          "properties": {
            "ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "sha256": {
              "oneOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "corpus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "research_context_fingerprint",
            "database_snapshot_ref"
          ],
          "properties": {
            "research_context_fingerprint": {
              "type": [
                "string",
                "null"
              ]
            },
            "database_snapshot_ref": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "image_digest",
            "provider",
            "model",
            "model_sha256"
          ],
          "properties": {
            "profile": {
              "type": [
                "string",
                "null"
              ]
            },
            "image_digest": {
              "type": [
                "string",
                "null"
              ]
            },
            "provider": {
              "type": [
                "string",
                "null"
              ]
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "model_sha256": {
              "oneOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "satisfied_blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "issue_number",
              "convergence_sha",
              "observed_at"
            ],
            "properties": {
              "issue_number": {
                "type": "integer",
                "minimum": 1
              },
              "convergence_sha": {
                "$ref": "#/$defs/sha1"
              },
              "observed_at": {
                "$ref": "#/$defs/timestamp"
              }
            }
          }
        },
        "origin": {
          "enum": [
            "scheduled_sweep",
            "imported_historical_validation"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "run_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "run_id",
        "case_id",
        "completed_at",
        "outcome",
        "classification",
        "evidence_refs",
        "defect_issues",
        "notes"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "run_result"
        },
        "run_id": {
          "$ref": "#/$defs/run_id"
        },
        "case_id": {
          "$ref": "#/$defs/case_id"
        },
        "completed_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EXECUTED"
          ]
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "defect_issues": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "enum": [
            "scheduled_sweep",
            "imported_historical_validation"
          ]
        },
        "reported_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifact_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "case_input_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_request_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "bundle_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "bundle_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_run_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
